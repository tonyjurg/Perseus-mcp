  "search_perseus": {
    "schema": {
      "description": "Search Perseus texts via Scaife API.\n\nFor Greek searches, `query` may be Unicode Greek or Beta Code.  The default\n`query_format=\"auto\"` detects explicit Beta Code marks such as `=`, `/`,\n`(`, `)`, and `*`, and also accepts short unaccented Beta Code queries such\nas `logos`.  Set `query_format=\"betacode\"` to force conversion or\n`query_format=\"unicode\"` to preserve ASCII text in Greek searches.\nThe `language` value determines whether Greek query normalization is applied;\nit is not sent to Scaife as a corpus language filter.\nOptional `author` resolves a CTS author/textgroup name or URN, then locally\nfilters the current Scaife result page to matching CTS URN prefixes.\n`search_kind` may be \"form\" or \"lemma\". Set `preserve_operators=True` for\nScaife operator queries such as quoted phrases, `-`, `|`, `*`, or `~`.\nOptional `page_num`, `text_group`, `work`, and `result_format` are passed\nto Scaife's library search endpoint. When `author` resolves to exactly one\nCTS textgroup and no explicit `text_group` or `work` is supplied, the\nauthor scope is sent to Scaife as a server-side `text_group` filter.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string"
          },
          "language": {
            "default": "greek",
            "type": "string"
          },
          "query_format": {
            "default": "auto",
            "type": "string"
          },
          "author": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "search_kind": {
            "default": "form",
            "type": "string"
          },
          "preserve_operators": {
            "default": false,
            "type": "boolean"
          },
          "page_num": {
            "default": 1,
            "type": "integer"
          },
          "text_group": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "work": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "result_format": {
            "default": "instances",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "type": "object",
        "x-fastmcp-wrap-result": true
      }
    },
    "signature": "(query: 'str', language: 'str' = 'greek', query_format: 'str' = 'auto', author: 'str | None' = None, search_kind: 'str' = 'form', preserve_operators: 'bool' = False, page_num: 'int' = 1, text_group: 'str | None' = None, work: 'str | None' = None, result_format: 'str' = 'instances') -> 'str'"
  },
