  "find_author_names": {
    "schema": {
      "description": "Find author/textgroup names by partial name match across Perseus catalogs.\n\nThis merges the legacy CTS capabilities inventory with Scaife's library\ncatalog, then matches author/textgroup name fields only, not work titles.\nA result can therefore be found when either upstream inventory contains it.\n`limit` must be between 1 and 500. Use `offset` with `has_more` to page\nthrough all matching authors.\nExamples:\n- query: \"Hom\"\n- query: \"Plut\"",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string"
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "limit": {
            "default": 100,
            "type": "integer"
          },
          "offset": {
            "default": 0,
            "type": "integer"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "type": "object",
        "x-fastmcp-wrap-result": true
      }
    },
    "signature": "(query: 'str', language: 'str | None' = None, limit: 'int' = 100, offset: 'int' = 0) -> 'str'"
  },
